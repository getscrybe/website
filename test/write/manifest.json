{
  "manifest_version": 3,
  "name": "Scrybe",
  "version": "1.0",
  "description": "AI essay writer that generates and types your essay into Google Docs.",
  "permissions": ["sidePanel", "tabs", "activeTab", "scripting"],
  "host_permissions": ["https://docs.google.com/*","https://api.deepseek.com/*"],
  "side_panel": {
    "default_path": "sidebar.html"
  },
  "icons": {
    "16":  "Scrybe.png",
    "48":  "Scrybe.png",
    "128": "Scrybe.png"
  },
  "action": {
    "default_title": "Open Sidebar"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://docs.google.com/*"],
      "js": ["content.js"]
    }
  ]
}