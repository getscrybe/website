{
  "manifest_version": 3,
  "name": "My Sidebar Extension",
  "version": "1.0",
  "description": "A simple sidebar panel extension",
  "permissions": ["sidePanel", "tabs"],
  "side_panel": {
    "default_path": "sidebar.html"
  },
  "action": {
    "default_title": "Open Sidebar"
  },
  "background": {
    "service_worker": "background.js"
  }
}